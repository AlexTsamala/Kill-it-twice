{
  "name": "kill-it-twice",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL to Elasticsearch + RabbitMQ replication pipeline",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test \"dist/src/**/*.test.js\"",
    "migrate": "node dist/scripts/migrate.js",
    "seed": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.2",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "amqplib": "^2.0.1",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
