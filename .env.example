# Every variable below is required. src/common/config.ts validates this set at startup and
# refuses to boot if any is missing. `make up` copies this file to .env if none exists.

# Runtime role: api | worker | consumer (D8)
APP_ROLE=api
LOG_LEVEL=info
HTTP_PORT=3000

# Postgres — source of truth.
# DATABASE_URL must stay consistent with POSTGRES_USER / PASSWORD / DB; the host is the
# compose service name, so it resolves inside the network.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=killittwice
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@postgres:5432/killittwice
PG_POOL_MAX=10

# Elasticsearch — current-state sink. Index carries the strict mapping (SPEC §6); reads go
# through the alias.
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms2g -Xmx2g
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products-v1
ELASTICSEARCH_ALIAS=products-read

# RabbitMQ — event stream sink (SPEC §7).
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://app:app@rabbitmq:5672
RABBITMQ_EXCHANGE=product.events
RABBITMQ_QUEUE=product.consumer
RABBITMQ_PREFETCH=100

# Replication. BATCH_SIZE is 500 by D7. BACKFILL_PUBLISH_EVENTS=false drops backfill's
# RabbitMQ publishing (D6) — only against the SPEC §2 time budget, and only if recorded.
BATCH_SIZE=500
OUTBOX_POLL_INTERVAL_MS=250
BACKFILL_PUBLISH_EVENTS=true

# How often worker and consumer flush their counters to Postgres for the api to serve.
METRICS_FLUSH_INTERVAL_MS=2000

# Retry (SPEC §8): sleep = random(0, min(RETRY_CAP_MS, RETRY_BASE_MS * 2^attempt))
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=1000
RETRY_CAP_MS=30000

# Seed (SPEC §4)
SEED_TOTAL=2000000
SEED_BATCH_SIZE=10000
